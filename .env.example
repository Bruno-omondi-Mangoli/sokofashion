# Which environment this is: local, staging or production
APP_ENV=local

# The public address of the site, with no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project address and publishable key. Both are public by design.
# Run npm run db:status to see the local values.
