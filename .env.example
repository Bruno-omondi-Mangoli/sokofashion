NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Used only by the development seed script, which refuses to run anywhere but locally.
# Use the local key from npm run db:status. Never a staging or production key.
SUPABASE_SERVICE_ROLE_KEY= sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
